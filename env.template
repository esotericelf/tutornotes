# Supabase Configuration
# Get these values from your Supabase project dashboard
# NOTE: Only use the ANON key in frontend code, NEVER the SERVICE ROLE key
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Production URL Configuration
# Set this to your production domain (e.g., https://yourdomain.com)
# This is used for OAuth redirects in production
REACT_APP_PRODUCTION_URL=https://yourdomain.com

# Comma-separated admin emails (Create React App embeds REACT_APP_* only).
# Also reads NEXT_PUBLIC_ADMIN_EMAILS if present in the build environment.
REACT_APP_ADMIN_EMAILS=you@example.com
# NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# FastAPI staging / solution-reviewer backend (local or remote)
REACT_APP_STAGING_API_URL=http://localhost:8000
# REACT_APP_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# IMPORTANT: DO NOT add REACT_APP_SUPABASE_SERVICE_ROLE_KEY here
# The service role key should only be used in backend/server code
# Adding it to frontend code is a security risk

# Google OAuth Configuration (Optional)
# Get these from Google Cloud Console after setting up OAuth
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id

# Discord OAuth Configuration (Optional)
# Get these from Discord Developer Portal after setting up OAuth
REACT_APP_DISCORD_CLIENT_ID=your_discord_client_id

# Facebook OAuth Configuration (Optional)
# Get these from Facebook Developers Console after setting up OAuth


# Note: Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

